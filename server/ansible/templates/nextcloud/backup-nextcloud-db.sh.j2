#!/bin/bash
# ansible/templates/nextcloud/backup-nextcloud-db.sh.j2
# Dump diário do Postgres do Nextcloud e cópia do config/ (banco e config ficam no disco local da VM, fora
# dos snapshots ZFS; o config.php guarda instanceid, secret e passwordsalt, necessários numa restauração).
# Instalado em /usr/local/sbin pelo setup-cloud-stack-volumes.yml e chamado pelo timer systemd
# backup-nextcloud-db.timer. Restauração: página 11.
set -euo pipefail

destino="{{ vm_nfs_mount_base_path }}/{{ zfs_docker_volumes_dataset_name }}/nextcloud/db-dumps"
arquivo="$destino/nextcloud-$(date +%F).dump"

config="$destino/nextcloud-config-$(date +%F).tar.gz"

docker exec nextcloud_db pg_dump -U nextcloud -d nextcloud -Fc > "$arquivo.tmp"
mv "$arquivo.tmp" "$arquivo"
tar -czf "$config.tmp" -C "{{ vm_local_data_path }}/nextcloud/config" .
mv "$config.tmp" "$config"
# Mantém duas semanas; sobras de uma execução que falhou no meio também saem.
find "$destino" \( -name 'nextcloud-*.dump' -o -name 'nextcloud-config-*.tar.gz' -o -name '*.tmp' \) -mtime +14 -delete
