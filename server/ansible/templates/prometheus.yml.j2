# ansible/templates/prometheus.yml.j2
global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']
        labels:
          instance: 'prometheus'

  # Alloy (coletor de logs e métricas em cada host): as métricas chegam por remote_write;
  # este job raspa só o /metrics do próprio Alloy, para saber se cada host está vivo (up).
  - job_name: 'alloy'
    static_configs:
      - targets: ['{{ proxmox_host_ip_var }}:12345']
        labels:
          instance: 'proxmox_main_host'
      - targets: ['{{ core_services_vm_ip_var }}:12345']
        labels:
          instance: 'core-services-vm'
{% if 'ai_desktop' in groups %}
      - targets: ['{{ ai_desktop_vm_ip_var }}:12345']
        labels:
          instance: 'ai-desktop-vm'
{% endif %}

  - job_name: 'cloudflared_tunnel'
    static_configs:
      - targets: ['cloudflared:2000']
        labels:
          instance: 'cloudflared_tunnel_metrics'

  # Disponibilidade (integração notificacoes, regra NTF-1): um alvo por aplicação, com label app = id do catálogo.
  # URLs INTERNAS (o blackbox-exporter está nas redes proxy e internal_services): a URL pública passa pelo
  # Authelia, que responderia por qualquer aplicação. O alvo do traefik usa o módulo tls_traefik, que também
  # mede a validade do certificado Let's Encrypt servido pelo Traefik (regra certificado-vencendo).
  - job_name: 'blackbox_http'
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets: ['http://authelia:9091/api/health']
        labels: {app: 'authelia'}
      - targets: ['http://grafana:3000/api/health']
        labels: {app: 'grafana'}
      - targets: ['http://homeassistant:8123/manifest.json']
        labels: {app: 'homeassistant'}
      - targets: ['http://homepage:3000/api/healthcheck']
        labels: {app: 'homepage'}
      - targets: ['http://jellyfin:8096/health']
        labels: {app: 'jellyfin'}
      - targets: ['http://lidarr:8686/ping']
        labels: {app: 'lidarr'}
      - targets: ['http://prowlarr:9696/ping']
        labels: {app: 'prowlarr'}
      - targets: ['http://bazarr:6767/']
        labels: {app: 'bazarr'}
      - targets: ['http://seerr:5055/api/v1/status']
        labels: {app: 'seerr'}
      - targets: ['http://n8n:5678/healthz']
        labels: {app: 'n8n'}
      - targets: ['http://nextcloud_app/status.php']
        labels: {app: 'nextcloud'}
      - targets: ['http://collabora:9980/hosting/discovery']
        labels: {app: 'collabora'}
      - targets: ['http://immich_server:2283/api/server/ping']
        labels: {app: 'immich'}
      - targets: ['https://portainer:9443/api/system/status']
        labels: {app: 'portainer', __param_module: 'http_2xx_inseguro'}
      - targets: ['http://prometheus:9090/-/healthy']
        labels: {app: 'prometheus'}
      - targets: ['http://gluetun:8088/']
        labels: {app: 'qbittorrent'} # WebUI pela rede do gluetun: falha se o gluetun ou o qBittorrent cair
      - targets: ['http://gluetun:9999/']
        labels: {app: 'qbittorrent'} # saúde do gluetun: 500 quando o túnel da VPN cai
      - targets: ['http://radarr:7878/ping']
        labels: {app: 'radarr'}
      - targets: ['http://sonarr:8989/ping']
        labels: {app: 'sonarr'}
      - targets: ['https://traefik:443']
        labels: {app: 'traefik', __param_module: 'tls_traefik'}
      - targets: ['http://loki:3100/ready']
        labels: {app: 'loki'}
      # Hub de MCPs (base dos agentes, página 13): o mcp_auth_servidor responde à metadata OAuth sem login.
      - targets: ['http://mcp_auth_servidor:80/.well-known/oauth-protected-resource']
        labels: {app: 'agentgateway'}
      # ...e o próprio hub (métricas no :15020, sem login): o proxy responde mesmo com o hub fora.
      - targets: ['http://agentgateway:15020/metrics']
        labels: {app: 'agentgateway'}
{% if 'ai_desktop' in groups %}
      - targets: ['http://{{ ai_desktop_vm_ip_var }}:3000/health']
        labels: {app: 'open-webui'}
      - targets: ['http://{{ ai_desktop_vm_ip_var }}:4000/health/liveliness']
        labels: {app: 'litellm'}
      # Segundo cérebro (página 12): os mcp-auth-proxy respondem a metadata OAuth sem login; o Syncthing, a saúde.
      - targets: ['http://{{ ai_desktop_vm_ip_var }}:8481/.well-known/oauth-protected-resource']
        labels: {app: 'notas'}
      - targets: ['http://{{ ai_desktop_vm_ip_var }}:8482/.well-known/oauth-protected-resource']
        labels: {app: 'notas-escrita'}
      - targets: ['http://{{ ai_desktop_vm_ip_var }}:8384/rest/noauth/health']
        labels: {app: 'syncthing'}
      # Rastreio (base dos agentes, página 13).
      - targets: ['http://{{ ai_desktop_vm_ip_var }}:3100/api/public/health']
        labels: {app: 'langfuse'}
{% endif %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115

  # Hub de MCPs (página 13): chamadas por rota, alvo e ferramenta (stack agents, rede proxy).
  - job_name: 'agentgateway'
    static_configs:
      - targets: ['agentgateway:15020']
        labels: {app: 'agentgateway'}
{% if 'ai_desktop' in groups %}

  # Gateway LiteLLM: tokens, custo e latência por chave e modelo (servidor de métricas na porta 4001, só LAN).
  - job_name: 'litellm'
    static_configs:
      - targets: ['{{ ai_desktop_vm_ip_var }}:4001']
        labels: {app: 'litellm'}
{% endif %}
