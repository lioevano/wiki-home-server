# ansible/templates/homepage/services.yaml.j2
# Painel (integração painel): uma entrada por aplicação do catálogo com Exposição != interna (PNL-1).
# Status: na core-services-vm, o estado do container (server/container, via docker-socket-proxy);
# em outra VM, siteMonitor pela URL da LAN (a URL pública passa pelo Authelia e falharia no teste).
# Entradas
# no grupo da sua Categoria; widgets (PNL-2) com credenciais SÓ como placeholders HOMEPAGE_VAR_* entre chaves duplas,
# que a Homepage substitui a partir do próprio ambiente (monitoring.env). O bloco raw impede o Ansible de interpretá-los.
# Gerado pelo setup-monitoring-stack-volumes.yml em <NFS>/homepage/config/services.yaml.
- infra:
    - authelia:
        icon: authelia.png
        href: https://auth.{{ base_domain }}
        server: core
        container: authelia
    - portainer:
        icon: portainer.png
        href: https://portainer.{{ base_domain }}
        server: core
        container: portainer
        widget:
          type: portainer
          url: https://portainer:9443
          env: 1
          key: "{% raw %}{{HOMEPAGE_VAR_PORTAINER_KEY}}{% endraw %}"
    - traefik:
        icon: traefik.png
        href: https://traefik.{{ base_domain }}
        server: core
        container: traefik
- produtividade:
    - nextcloud:
        icon: nextcloud.png
        href: https://nextcloud.{{ base_domain }}
        server: core
        container: nextcloud_app
        widget:
          type: nextcloud
          url: http://nextcloud_app
          key: "{% raw %}{{HOMEPAGE_VAR_NEXTCLOUD_KEY}}{% endraw %}"
    - immich:
        icon: immich.png
        href: https://fotos.{{ base_domain }}
        server: core
        container: immich_server
        widget:
          type: immich
          url: http://immich_server:2283
          key: "{% raw %}{{HOMEPAGE_VAR_IMMICH_KEY}}{% endraw %}"
          version: 2
    - collabora:
        icon: collabora-online.png
        href: https://office.{{ base_domain }}
        server: core
        container: collabora
    - syncthing:
        icon: syncthing.png
        href: https://sync.{{ base_domain }}
        siteMonitor: http://{{ ai_desktop_vm_ip_var }}:8384/rest/noauth/health
- mídia:
    - bazarr:
        icon: bazarr.png
        href: https://bazarr.{{ base_domain }}
        server: core
        container: bazarr
        widget:
          type: bazarr
          url: http://bazarr:6767
          key: "{% raw %}{{HOMEPAGE_VAR_BAZARR_KEY}}{% endraw %}"
    - jellyfin:
        icon: jellyfin.png
        href: https://jellyfin.{{ base_domain }}
        server: core
        container: jellyfin
        widget:
          type: jellyfin
          url: http://jellyfin:8096
          key: "{% raw %}{{HOMEPAGE_VAR_JELLYFIN_KEY}}{% endraw %}"
    - lidarr:
        icon: lidarr.png
        href: https://lidarr.{{ base_domain }}
        server: core
        container: lidarr
        widget:
          type: lidarr
          url: http://lidarr:8686
          key: "{% raw %}{{HOMEPAGE_VAR_LIDARR_KEY}}{% endraw %}"
    - prowlarr:
        icon: prowlarr.png
        href: https://prowlarr.{{ base_domain }}
        server: core
        container: prowlarr
        widget:
          type: prowlarr
          url: http://prowlarr:9696
          key: "{% raw %}{{HOMEPAGE_VAR_PROWLARR_KEY}}{% endraw %}"
    - qbittorrent:
        icon: qbittorrent.png
        href: https://qbittorrent.{{ base_domain }}
        server: core
        container: qbittorrent
        widget:
          type: qbittorrent
          url: http://gluetun:8088 # o qBittorrent usa a rede do gluetun (VPN)
          username: "{% raw %}{{HOMEPAGE_VAR_QBITTORRENT_USER}}{% endraw %}"
          password: "{% raw %}{{HOMEPAGE_VAR_QBITTORRENT_PASSWORD}}{% endraw %}"
    - radarr:
        icon: radarr.png
        href: https://radarr.{{ base_domain }}
        server: core
        container: radarr
        widget:
          type: radarr
          url: http://radarr:7878
          key: "{% raw %}{{HOMEPAGE_VAR_RADARR_KEY}}{% endraw %}"
    - seerr:
        icon: jellyseerr.png
        href: https://pedidos.{{ base_domain }}
        server: core
        container: seerr
        # Widget 'jellyseerr' da Homepage: a API do Seerr é a mesma do Jellyseerr.
        widget:
          type: jellyseerr
          url: http://seerr:5055
          key: "{% raw %}{{HOMEPAGE_VAR_SEERR_KEY}}{% endraw %}"
    - sonarr:
        icon: sonarr.png
        href: https://sonarr.{{ base_domain }}
        server: core
        container: sonarr
        widget:
          type: sonarr
          url: http://sonarr:8989
          key: "{% raw %}{{HOMEPAGE_VAR_SONARR_KEY}}{% endraw %}"
- monitoramento:
    - grafana:
        icon: grafana.png
        href: https://grafana.{{ base_domain }}
        server: core
        container: grafana
        widget:
          type: grafana
          url: http://grafana:3000
          username: admin
          password: "{% raw %}{{HOMEPAGE_VAR_GRAFANA_PASSWORD}}{% endraw %}"
    - prometheus:
        icon: prometheus.png
        href: https://prometheus.{{ base_domain }}
        server: core
        container: prometheus
        widget:
          type: prometheus
          url: http://prometheus:9090
- automação:
    - homeassistant:
        icon: home-assistant.png
        href: https://hass.{{ base_domain }}
        server: core
        container: homeassistant
        widget:
          type: homeassistant
          url: http://homeassistant:8123
          key: "{% raw %}{{HOMEPAGE_VAR_HOMEASSISTANT_KEY}}{% endraw %}"
    - n8n:
        icon: n8n.png
        href: https://n8n.{{ base_domain }}
        server: core
        container: n8n_app
- ia:
    - open-webui:
        icon: open-webui.png
        href: https://openwebui.{{ base_domain }}
        siteMonitor: http://{{ ai_desktop_vm_ip_var }}:3000
    - litellm:
        icon: litellm.png
        href: https://llm.{{ base_domain }}
        siteMonitor: http://{{ ai_desktop_vm_ip_var }}:4000/health/liveliness
    - notas:
        icon: obsidian.png
        href: https://notas.{{ base_domain }}
        siteMonitor: http://{{ ai_desktop_vm_ip_var }}:8481/.well-known/oauth-protected-resource
    - notas-escrita:
        icon: obsidian.png
        href: https://escrita.{{ base_domain }}
        siteMonitor: http://{{ ai_desktop_vm_ip_var }}:8482/.well-known/oauth-protected-resource
    - servidor:
        icon: mdi-server-network
        description: MCP do servidor (leitura)
        href: https://servidor.{{ base_domain }}
        siteMonitor: http://mcp_auth_servidor:80/.well-known/oauth-protected-resource
    - langfuse:
        icon: langfuse.png
        description: Rastreio de LLM e ferramentas
        href: https://langfuse.{{ base_domain }}
        siteMonitor: http://{{ ai_desktop_vm_ip_var }}:3100/api/public/health
