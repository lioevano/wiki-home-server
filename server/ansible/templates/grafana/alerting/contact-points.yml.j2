# ansible/templates/grafana/alerting/contact-points.yml.j2
# Pontos de contato (integração notificacoes). Os segredos ficam no ambiente do Grafana
# (monitoring.env) e são interpolados pelo provisioning: nada de valor real neste arquivo.
apiVersion: 1
contactPoints:
  - orgId: 1
    name: n8n
    receivers:
      - uid: n8n-webhook
        type: webhook
        disableResolveMessage: false
        settings:
          url: http://n8n:5678/webhook/notificar
          httpMethod: POST
          authorization_scheme: Bearer
          authorization_credentials: "${NOTIFICACOES_WEBHOOK_TOKEN}"
      # IA que observa o servidor (página 15): recebe o mesmo alerta, investiga pela rota de leitura do hub e
      # manda a análise pelo n8n. Integração independente: se o observador estiver fora, o n8n recebe igual.
      - uid: observador-webhook
        type: webhook
        disableResolveMessage: true # só analisa o que dispara
        settings:
          url: http://observador:8080/alerta
          httpMethod: POST
          authorization_scheme: Bearer
          authorization_credentials: "${OBSERVADOR_TOKEN}"
  # Rota de reserva: só para o alerta "n8n fora do ar", que não pode depender do n8n.
  - orgId: 1
    name: telegram-direto
    receivers:
      - uid: telegram-direto
        type: telegram
        settings:
          bottoken: "${TELEGRAM_BOT_TOKEN}"
          chatid: "${TELEGRAM_CHAT_ID}"
