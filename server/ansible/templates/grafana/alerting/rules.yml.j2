# ansible/templates/grafana/alerting/rules.yml.j2
# Regras de alerta do Grafana (integração notificacoes). Gerado pelo setup-monitoring-stack-volumes.yml
# em <NFS>/grafana/provisioning/alerting/rules.yml.
# Atenção: o provisioning do Grafana interpola variáveis de ambiente ($VAR) fora do 'model';
# por isso os templates das anotações usam $$labels (escapa para $labels).
# ---- Limites: ajuste aqui ----
{% set disco_pct = 85 %}
{% set ram_pct = 90 %}
{% set ram_for = '10m' %}
{% set cpu_pct = 90 %}
{% set cpu_for = '15m' %}
{% set fora_do_ar_for = '3m' %}
{% set certificado_dias = 14 %}
{% set logins_falhos = 5 %}
{% set gasto_llm_dia = llm_gasto_diario_alerta | default(5) %}
{% set reinicios_max = 3 %}
{# nfs.*: o espaço do pool é medido no host; cada VM que monta o NFS repetiria o mesmo alerta #}
{% set fs = 'fstype!~"tmpfs|overlay|squashfs|nfs.*"' %}
{% set regras = [
  {'uid': 'servico-fora-do-ar', 'ds': 'prometheus', 'expr': '1 - probe_success{app!~"n8n|qbittorrent"}', 'op': 'gt', 'v': 0, 'for': fora_do_ar_for, 'sev': 'critical', 'summary': '{{ $$labels.app }} está fora do ar'},
  {'uid': 'n8n-fora-do-ar', 'ds': 'prometheus', 'expr': '1 - probe_success{app="n8n"}', 'op': 'gt', 'v': 0, 'for': fora_do_ar_for, 'sev': 'critical', 'summary': 'n8n fora do ar: as notificações estão paradas'},
  {'uid': 'qbittorrent-ou-vpn-fora', 'ds': 'prometheus', 'expr': '1 - probe_success{app="qbittorrent"}', 'op': 'gt', 'v': 0, 'for': fora_do_ar_for, 'sev': 'critical', 'summary': 'qBittorrent ou VPN (gluetun) fora: downloads parados'},
  {'uid': 'certificado-vencendo', 'ds': 'prometheus', 'expr': '(probe_ssl_earliest_cert_expiry{app="traefik"} - time()) / 86400', 'op': 'lt', 'v': certificado_dias, 'for': '1h', 'sev': 'warning', 'summary': 'Certificado Let’s Encrypt do Traefik vence em menos de ' ~ certificado_dias ~ ' dias'},
  {'uid': 'disco-cheio', 'ds': 'prometheus', 'expr': '100 * (1 - node_filesystem_avail_bytes{' ~ fs ~ '} / node_filesystem_size_bytes{' ~ fs ~ '})', 'op': 'gt', 'v': disco_pct, 'for': '5m', 'sev': 'warning', 'summary': 'Disco {{ $$labels.mountpoint }} em {{ $$labels.instance }} acima de ' ~ disco_pct ~ '%'},
  {'uid': 'ram-alta', 'ds': 'prometheus', 'expr': '100 * (1 - (node_memory_MemAvailable_bytes + (node_zfs_arc_size or node_memory_MemAvailable_bytes * 0)) / node_memory_MemTotal_bytes)', 'op': 'gt', 'v': ram_pct, 'for': ram_for, 'sev': 'warning', 'summary': 'RAM de {{ $$labels.instance }} acima de ' ~ ram_pct ~ '%'},
  {'uid': 'cpu-alta', 'ds': 'prometheus', 'expr': '100 - avg by (instance) (rate(node_cpu_seconds_total{mode="idle"}[5m])) * 100', 'op': 'gt', 'v': cpu_pct, 'for': cpu_for, 'sev': 'warning', 'summary': 'CPU de {{ $$labels.instance }} acima de ' ~ cpu_pct ~ '%'},
  {'uid': 'host-sem-resposta', 'ds': 'prometheus', 'expr': '1 - up{job=~"alloy|blackbox_http"}', 'op': 'gt', 'v': 0, 'for': fora_do_ar_for, 'sev': 'critical', 'summary': '{{ $$labels.instance }} não responde ({{ $$labels.job }})'},
  {'uid': 'zfs-degradado', 'ds': 'prometheus', 'expr': 'node_zfs_zpool_state{state!="online"}', 'op': 'gt', 'v': 0, 'for': '1m', 'sev': 'critical', 'summary': 'Pool ZFS {{ $$labels.zpool }} em estado {{ $$labels.state }}'},
  {'uid': 'container-reiniciando', 'ds': 'prometheus', 'expr': 'resets(container_cpu_usage_seconds_total{name!=""}[15m])', 'op': 'gt', 'v': reinicios_max, 'for': '0s', 'sev': 'warning', 'summary': '{{ $$labels.name }} reiniciou mais de ' ~ reinicios_max ~ ' vezes em 15 min ({{ $$labels.instance }})'},
  {'uid': 'authelia-logins-falhos', 'ds': 'loki', 'expr': 'sum(count_over_time({job="docker_logs"} != "query=" |~ "Unsuccessful (1FA|TOTP|WebAuthn|Duo) authentication attempt" [10m]))', 'op': 'gt', 'v': logins_falhos, 'for': '0s', 'sev': 'warning', 'summary': 'Mais de ' ~ logins_falhos ~ ' logins falhos no Authelia em 10 min'},
  {'uid': 'llm-gasto-alto', 'ds': 'prometheus', 'expr': 'sum(increase(litellm_spend_metric_total[1d]))', 'op': 'gt', 'v': gasto_llm_dia, 'for': '0s', 'sev': 'warning', 'summary': 'Gasto com LLM nas últimas 24 h passou de US$ ' ~ gasto_llm_dia ~ ' (veja llm.)'},
  {'uid': 'ops-acao-falhou', 'ds': 'loki', 'expr': 'sum(count_over_time({job="docker_logs"} |= "\\"evento\\": \\"ops_acao\\"" |= "\\"resultado\\": \\"erro\\"" [10m]))', 'op': 'gt', 'v': 0, 'for': '0s', 'sev': 'warning', 'summary': 'Uma ação da IA no servidor (ops: container, stack ou Ansible) falhou — veja o log do ops_controle'},
  {'uid': 'timer-falhou', 'ds': 'prometheus', 'expr': 'max_over_time(node_systemd_unit_state{name=~"(notes|backup)-.+\\\\.service", state="failed"}[30m])', 'op': 'gt', 'v': 0, 'for': '0s', 'sev': 'warning', 'summary': 'Tarefa agendada {{ $$labels.name }} falhou em {{ $$labels.instance }} (journalctl -u {{ $$labels.name }})'},
] %}
apiVersion: 1
groups:
  - orgId: 1
    name: homeserver
    folder: Homeserver
    interval: 1m
    rules:
{% for r in regras %}
      - uid: {{ r.uid }}
        title: {{ r.uid }}
        condition: C
        data:
          - refId: A
            relativeTimeRange: {from: 600, to: 0}
            datasourceUid: {{ r.ds }}
            model:
              refId: A
              expr: {{ r.expr | tojson }}
{% if r.ds == 'loki' %}
              queryType: instant
{% else %}
              instant: true
{% endif %}
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: A
              conditions:
                - evaluator: {type: {{ r.op }}, params: [{{ r.v }}]}
        noDataState: OK
        execErrState: Error
        for: {{ r['for'] }}
        labels:
          severity: {{ r.sev }}
        annotations:
          summary: {{ r.summary | tojson }}
{% endfor %}
