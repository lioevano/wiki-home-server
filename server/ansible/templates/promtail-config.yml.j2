# ansible/templates/promtail-config.yml.j2
server:
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  filename: /tmp/positions/positions.yaml

clients:
  - url: http://loki:3100/loki/api/v1/push

scrape_configs:
  - job_name: system_journal
    journal:
      max_age: 12h
      path: /var/log/journal
      labels:
        job: system_journal
        host: "{{ inventory_hostname }}"
    relabel_configs:
      - source_labels: ['__journal__systemd_unit']
        target_label: 'unit'

  - job_name: docker_logs
    static_configs:
      - targets:
          - localhost
        labels:
          job: docker_logs
          host: "{{ inventory_hostname }}"
          __path__: /var/lib/docker/containers/*/*-json.log
    pipeline_stages:
      - docker: {}
      - json:
          expressions:
            container_name: attrs.name
      - labels:
          container_name:

  - job_name: var_log_messages
    static_configs:
      - targets:
          - localhost
        labels:
          job: var_log
          host: "{{ inventory_hostname }}"
          __path__: /var/log/{messages,syslog,auth.log,kern.log}
