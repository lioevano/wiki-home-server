# ansible/roles/infra/sysadmin-gcp/templates/sysadmin-segredos.service.j2
# Segredos do sysadmin (página 19): lê o JSON sysadmin-segredos do Secret Manager (conta de serviço da VM) e o separa
# por container no tmpfs /run/sysadmin (separar_segredos.py; falha fechada, nada vai para o disco). O Docker exige
# esta unit (drop-in 20-sysadmin.conf): sem segredos, a stack não sobe. Na primeira vez, traz também o vault.yml
# cifrado que o criar-sysadmin.sh deixou no bucket. Para trocar os segredos: nova versão no Secret Manager e
# `systemctl restart sysadmin-segredos` (o Docker, que a exige, reinicia junto e os containers voltam com os novos).
# Falhou (rede ou Secret Manager fora): tenta de novo a cada minuto, sem limite. RestartMode=direct (systemd >= 254)
# faz cada nova tentativa pular o estado failed: a unit fica "activating", quem a exige (o Docker) não é avisado de
# falha passageira e o job de início do Docker espera na fila, subindo assim que os segredos chegam. Sem ele
# (RestartMode=normal, o padrão), a primeira falha derrubaria o job do Docker ("dependency") até o dia seguinte.
# Gerado pelo role infra/sysadmin-gcp.
[Unit]
Description=Segredos do sysadmin: Secret Manager para /run/sysadmin (página 19)
Wants=network-online.target
After=network-online.target snapd.seeded.service
Before=docker.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=true
Restart=on-failure
RestartMode=direct
RestartSec=60
UMask=0077
# gcloud vem como snap nas imagens Ubuntu da GCP; sem log em arquivo (~/.config/gcloud/logs no disco)
Environment=PATH=/snap/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=CLOUDSDK_CORE_DISABLE_FILE_LOGGING=1
# sobras de uma troca interrompida (o separar_segredos.py monta o diretório novo em /run/.sysadmin.*)
ExecStartPre=/bin/sh -c 'rm -rf /run/.sysadmin.*'
# pipefail: se o gcloud falhar, a unit falha (e o Restart tenta de novo).
ExecStart=/bin/bash -c 'set -o pipefail; gcloud secrets versions access latest --secret=sysadmin-segredos | python3 /usr/local/lib/sysadmin/separar_segredos.py --destino /run/sysadmin --uid-executor {{ sysadmin_executor_uid }} --uid-sysadmin {{ sysadmin_uid }}'
# Só se o executor ainda não gravou um: o vault.yml de entrada (cifrado; sem ele, vale o do repositório). Baixa
# num diretório do root (build/) e só renomeia para dentro de saida/ (do executor): o rename troca um symlink
# plantado em vez de segui-lo. Falha aqui não derruba a unit.
ExecStart=-/bin/sh -c 'set -e; test ! -e /opt/sysadmin/saida/vault.yml || exit 0; mkdir -p /opt/sysadmin/build /opt/sysadmin/saida; t=$$(mktemp -d /opt/sysadmin/build/.vault-entrada.XXXXXX); trap "rm -rf $$t" EXIT; gcloud storage cp gs://{{ sysadmin_bucket }}/entrada/vault.yml "$$t/vault.yml"; chown {{ sysadmin_executor_uid }}:{{ sysadmin_executor_uid }} "$$t/vault.yml"; chmod 0644 "$$t/vault.yml"; mv -T "$$t/vault.yml" /opt/sysadmin/saida/vault.yml'
TimeoutStartSec=5min

[Install]
WantedBy=multi-user.target
