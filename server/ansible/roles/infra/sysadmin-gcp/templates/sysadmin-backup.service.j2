# ansible/roles/infra/sysadmin-gcp/templates/sysadmin-backup.service.j2
# Backup diário do sysadmin no GCS (página 19); o timer sysadmin-backup o dispara. Gerado pelo role infra/sysadmin-gcp.
[Unit]
Description=Backup diário do sysadmin no GCS (página 19)
Wants=network-online.target
After=network-online.target docker.service
# Falhou: aviso no bot de aprovações.
OnFailure=sysadmin-alerta@%n.service

[Service]
Type=oneshot
UMask=0077
# sem log do gcloud em arquivo (~/.config/gcloud/logs no disco)
Environment=PATH=/snap/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=CLOUDSDK_CORE_DISABLE_FILE_LOGGING=1
ExecStart=/usr/local/sbin/sysadmin-backup.sh
