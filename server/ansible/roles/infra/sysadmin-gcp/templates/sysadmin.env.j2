# ansible/roles/infra/sysadmin-gcp/templates/sysadmin.env.j2
# .env da stack do sysadmin (/opt/sysadmin/stack/.env), lido pelo docker compose (página 02). Só valores não
# secretos: os segredos chegam por /run/sysadmin (separar_segredos.py). Gerado pelo role infra/sysadmin-gcp a cada
# ansible-pull; as variáveis são as do docker-compose.yml (contrato no .env.template).
SYSADMIN_IMAGE_TAG={{ sysadmin_version }}
EXECUTOR_IMAGE_TAG={{ executor_version }}
SYSADMIN_DATA_PATH=/opt/sysadmin
# A mesma sub-rede do firewall (sysadmin_rede_subnet, group_vars): uma fonte só.
SYSADMIN_REDE_SUBNET={{ sysadmin_rede_subnet }}
# Playbooks que o executor roda (nome -> descrição; a do ops quando há), em JSON entre aspas simples (literal).
EXECUTOR_PLAYBOOKS='{ {%- for p in executor_playbooks_permitidos -%}
{{ p | to_json }}: {{ (ops_playbooks_permitidos | selectattr('nome', 'equalto', p) | map(attribute='descricao') | first | default(p)) | to_json }}{{ ', ' if not loop.last else '' }}
{%- endfor -%} }'
# As rotas da casa no tailnet (/32 do host e das VMs): o preparar-host.sh as anuncia no host.
EXECUTOR_ROTAS={{ tailscale_rotas | join(',') }}
ANSIBLE_USUARIO_HOST={{ proxmox_ansible_user_on_host }}
REPO_URL_RAW={{ sysadmin_repo_url_raw }}
EQUIPE_REPO={{ equipe_repo }}
CONTA_SYSADMIN={{ conta_sysadmin }}
# HERMES_UID/GID do Hermes (dono de hermes/ e repo/; o --uid-sysadmin do separar_segredos.py).
DOCKER_PUID={{ sysadmin_uid }}
DOCKER_PGID={{ sysadmin_uid }}
SYSTEM_TIMEZONE={{ sysadmin_fuso_horario }}
