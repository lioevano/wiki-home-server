# ansible/roles/infra/sysadmin-gcp/templates/sysadmin-backup.timer.j2
# Todo dia às 06:07 UTC (página 19), depois da atualização das 05:17. Gerado pelo role infra/sysadmin-gcp.
[Unit]
Description=Backup diário do sysadmin no GCS (06:07 UTC)

[Timer]
OnCalendar=*-*-* 06:07:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
